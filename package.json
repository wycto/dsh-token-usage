{
  "name": "@yourname/dsh-token-usage",
  "version": "0.1.0",
  "description": "Token 用量记录与统计面板：记录 DSH 所有 LLM API 调用，支持秒级时间范围查询、多维度筛选、分组统计与 CSV 导出",
  "type": "module",
  "main": "lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./client": "./client/dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "echo \"host: plain ESM, nothing to build; client: run tsdown build\" && tsdown --config client/tsdown.config.ts",
    "pack": "pnpm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token",
    "usage",
    "statistics"
  ],
  "license": "MIT"
}
